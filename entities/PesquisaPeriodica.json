{
  "name": "PesquisaPeriodica",
  "type": "object",
  "properties": {
    "destinatario_email": {
      "type": "string",
      "description": "Email do colaborador que recebeu a pesquisa"
    },
    "destinatario_nome": {
      "type": "string",
      "description": "Nome do colaborador"
    },
    "destinatario_cargo": {
      "type": "string",
      "description": "Cargo do colaborador"
    },
    "destinatario_setor": {
      "type": "string",
      "description": "Setor do colaborador"
    },
    "remetente_email": {
      "type": "string",
      "description": "Email de quem enviou (RH/ADM)"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome de quem enviou"
    },
    "tipo_pesquisa": {
      "type": "string",
      "enum": [
        "7 dias",
        "45 dias",
        "90 dias"
      ],
      "description": "Per\u00edodo da pesquisa"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do envio"
    },
    "status_email": {
      "type": "string",
      "enum": [
        "enviado",
        "falha",
        "pendente"
      ],
      "default": "pendente",
      "description": "Status do envio do email"
    },
    "motivo_falha_email": {
      "type": "string",
      "description": "Detalhes do erro caso o envio falhe"
    }
  },
  "required": [
    "destinatario_email",
    "tipo_pesquisa",
    "remetente_email"
  ]
}